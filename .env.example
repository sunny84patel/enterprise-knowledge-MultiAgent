# ──────────────────────────────────────────────
# Enterprise Knowledge Agent — Environment Config
# Copy this to .env and fill in your values
# ──────────────────────────────────────────────

# LLM Provider: groq | openai | ollama
LLM_PROVIDER=groq
# Groq: llama-3.1-8b-instant (llama3-8b-8192 decommissioned) | openai: gpt-4o | ollama: llama3
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.0

# API Keys (only fill the one you're using)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=sk-your_openai_key_here

# Qdrant (Docker local = default, or use Qdrant Cloud)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base

# Embeddings (free, runs locally on CPU)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# LangSmith Observability (get free key at smith.langchain.com)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__your_langsmith_key_here
LANGCHAIN_PROJECT=enterprise-knowledge-agent

# Web Search Fallback (optional — get free key at tavily.com)
TAVILY_API_KEY=tvly-your_tavily_key_here

# RAG settings
TOP_K_RETRIEVAL=5
MAX_CONTEXT_LENGTH=4000
REWRITE_MAX_ATTEMPTS=2

# LlamaIndex chunking
LLAMA_CHUNK_SIZE=512
LLAMA_CHUNK_OVERLAP=50
